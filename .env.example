# Infraestrutura local

# API — persistência local (ADR 0003: SQLite de arquivo é o alvo de
# desenvolvimento e de entrega; nenhum servidor de banco é obrigatório).
DATABASE_URL=sqlite+aiosqlite:///./delta_force.sqlite3
SESSION_TTL_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:5173
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=crm-documents
MAIL_HOST=localhost
MAIL_PORT=1025

# Fundação legada em remoção (ADR 0003 / #54): Docker, PostgreSQL e MinIO não
# são pré-requisitos de desenvolvimento. Só são necessários para `just infra-up`
# e para o job PostgreSQL legado (`just api-test-integration`).
POSTGRES_DB=delta_force
POSTGRES_USER=delta_force
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

MINIO_ROOT_USER=delta-force-local
MINIO_ROOT_PASSWORD=change-me-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Para rodar os checks legados de PostgreSQL, troque DATABASE_URL por:
# postgresql+psycopg://delta_force:change-me-local@localhost:5432/delta_force
