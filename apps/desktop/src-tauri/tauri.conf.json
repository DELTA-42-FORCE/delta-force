{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta Force CRM",
  "version": "0.1.0",
  "identifier": "br.com.deltaforce.crm",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Delta Force CRM",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/api-sidecar": "api-sidecar"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
